diff --git a/lib/inbound-match.ts b/lib/inbound-match.ts
index 7ee77ec..d72e91b 100644
--- a/lib/inbound-match.ts
+++ b/lib/inbound-match.ts
@@ -74,7 +74,20 @@ export async function resolveInbound(admin: any, e: InboundEmail) {
     // A carrier's address alone is not enough (it may also send us a fresh request): only treat it as a carrier
     // reply when the mail looks like a reply — header references, a Re:/AW: subject, or one of our RFQ codes.
     const looksLikeReply = refsIds.length > 0 || /^\s*(re|aw|sv|rv)\s*:/i.test(String(e.subject ?? "")) || /RFQ-[0-9a-f]{8}-\d+-[0-9a-f]{6}/i.test(text)
-    if (cs?.length && looksLikeReply) {
+    // The same address can be both a requester and a carrier. If the headers show this mail answers one of OUR
+    // requester-side emails (auto-reply, the original request, an earlier requester message) and none of our RFQs,
+    // it is the requester replying, not a carrier quote.
+    let answersRequesterSide = false
+    if (cs?.length && looksLikeReply && refsIds.length && !/RFQ-[0-9a-f]{8}-\d+-[0-9a-f]{6}/i.test(text)) {
+      const [{ data: outRfq }, { data: outReply }, { data: inb }, { data: frm }] = await Promise.all([
+        admin.from("outbound_emails").select("id").eq("client_code", clientCode).eq("purpose", "rfq").in("message_id", refsIds).limit(1),
+        admin.from("outbound_emails").select("id").eq("client_code", clientCode).eq("purpose", "reply").in("message_id", refsIds).limit(1),
+        admin.from("inbound_emails").select("id").eq("client_code", clientCode).in("message_id", refsIds).limit(1),
+        admin.from("freight_requests").select("id").eq("client_code", clientCode).in("message_id", refsIds).limit(1),
+      ])
+      answersRequesterSide = !outRfq?.length && !!(outReply?.length || inb?.length || frm?.length)
+    }
+    if (cs?.length && looksLikeReply && !answersRequesterSide) {
       const { data: rfqs } = await admin.from("carrier_quote_requests").select("id, freight_request_id, rfq_reference, sent_at, status").in("carrier_id", cs.map((c: any) => c.id)).order("sent_at", { ascending: false }).limit(10)
       if (rfqs?.length) return { ...base, decision: "carrier_reply" as const, method: "carrier_sender", confidence: 0.8, rfqs }
     }
